
% for p in publications:
<div class="publication">
    <p>
      <strong>${p['title']}</strong><br>
      <i>${p['authors']}</i><br>
      <strong>${p['journal_short']}</strong><br>
      <button data-bibtex="${p['bibtex'] | h}" onclick="copyBibtex(this.dataset.bibtex)">Copy BibTeX</button>
      <a href="${p['pdf']}">
        <button>PDF</button>
      </a>
    </p>
  </div>
% endfor
